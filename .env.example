# Copia a .env (nunca subir .env). Sin secretos en código, Notion, capturas ni logs.
PULSO_DATA=data/sample            # carpeta del paquete (cambiar al oficial: data/oficial)
PULSO_OUT=out
PULSO_EMBED=tfidf                 # tfidf (offline, sin descargas) | st (sentence-transformers)
PULSO_ST_MODEL=                   # modelo multilingüe elegido; fijar versión (ver docs/DECISIONES.md)
PULSO_CLUSTER_DISTANCE=0.82       # recalibrar con el paquete oficial y etiquetas humanas
PULSO_LLM_PROVIDER=none           # none | ollama | anthropic  (none = plantilla, siempre funciona)
PULSO_OLLAMA_MODEL=
PULSO_ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
PULSO_DESDE=2024-01-01            # intervalo de registros (bases §7); ver docs/09 por posible conflicto
PULSO_HASTA=2025-10-01
HF_HUB_OFFLINE=1                  # tras `make models`, forzar modelos locales
TRANSFORMERS_OFFLINE=1
